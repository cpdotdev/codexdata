{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex quota window policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset", "schemaVersion", "revision", "verifiedAt", "sources", "plans"],
  "properties": {
    "dataset": { "const": "codex-quota-policy" },
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "verifiedAt": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://(developers\\.openai\\.com|help\\.openai\\.com|openai\\.com|learn\\.chatgpt\\.com|chatgpt\\.com)/[^\\s]*$"
      }
    },
    "plans": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 100,
      "propertyNames": { "pattern": "^[a-z0-9_-]+$", "maxLength": 64 },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["windows", "evidenceStatus", "note"],
        "properties": {
          "windows": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["short", "weekly", "monthly"] }
          },
          "evidenceStatus": { "enum": ["confirmed", "unconfirmed"] },
          "note": { "type": "string", "minLength": 1, "maxLength": 6000, "pattern": "\\S" }
        },
        "if": { "properties": { "evidenceStatus": { "const": "unconfirmed" } } },
        "then": { "properties": { "windows": { "maxItems": 0 } } }
      }
    }
  }
}
